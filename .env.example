# Grievance Data Anonymization Environment Configuration
# Copy this file to .env and populate with deployment specific values.

# HuggingFace access token (required for gated repos like ai4bharat/IndicNER)
HF_TOKEN=

# Multilingual batch job line mini-batch size (granularity of inference progress)
NER_CORPUS_BATCH_SIZE=256

# Tensor batch size for model execution (auto-tuned if 0 based on CPU threads)
NER_TENSOR_BATCH_SIZE=0

# PyTorch CPU thread count override (0 leaves default torch setting)
NER_TORCH_THREADS=0

# Dynamic INT8 quantization toggle (true/false, default false to maintain high recall)
NER_QUANTIZE=false
